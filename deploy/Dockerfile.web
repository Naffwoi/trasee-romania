FROM node:22-alpine
RUN apk add --no-cache curl
WORKDIR /app
RUN mkdir -p uploads
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY build ./build
COPY watcher.js server.js ./
COPY src/lib/server/upload_body_limit.js ./src/lib/server/
ENV MEILI_URL=http://127.0.0.1:7700 \
    PUBLIC_DISABLE_SIGNUP=false \
    PUBLIC_OVERPASS_API_URL= \
    PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090 \
    UPLOAD_PASSWORD= \
    UPLOAD_USER=
EXPOSE 3000
CMD ["/bin/sh", "-c", "if [ -n \"${UPLOAD_FOLDER:-}\" ] && { [ -n \"${UPLOAD_USER:-}\" ] || [ \"${ENABLE_UPLOAD_WATCHER:-}\" = \"true\" ]; }; then node watcher.js & fi; exec node --max-old-space-size=320 server.js"]
